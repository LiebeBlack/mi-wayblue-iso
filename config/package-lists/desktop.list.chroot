# Firmware Intel non-free: grafica UHD 600 (i915) + Wi-Fi + microcodigo
firmware-intel-graphics
firmware-iwlwifi
intel-microcode

# Aceleracion grafica Mesa
libgl1-mesa-dri

# Compositor Wayland ultraligero (estilo Openbox)
# SIN panel a proposito: escritorio desnudo, todo se lanza con fuzzel (Super+d)
labwc

# Lanzador + terminal + notificaciones + fondo de pantalla
fuzzel
foot
foot-themes
swaybg
mako-notifier

# Bloqueo de pantalla y brillo (300e: pantalla integrada, fanless)
swaylock
brightnessctl

# Sesion: bus D-Bus de sesion + portal Wayland + agente PolicyKit
dbus-user-session
xdg-desktop-portal
xdg-desktop-portal-wlr
polkitd
lxpolkit

# Login grafico ligero (sin GDM/SDDM/LightDM)
greetd
tuigreet

# Red: NetworkManager con backend iwd para el Wi-Fi Intel
network-manager
iwd

# Audio de bajo consumo PipeWire
pipewire
pipewire-audio
wireplumber

# Termico: el 300e es fanless; thermald gestiona las zonas ACPI
thermald

# Instalador live: se lanza desde el menu de labwc y crea TU usuario
debian-installer-launcher

# Utilidades minimas
sudo
nano
less
curl
