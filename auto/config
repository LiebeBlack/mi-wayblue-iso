#!/bin/sh
set -e

# ---------------------------------------------------------------------------
# Debian 14 "forky" (beta) - Labwc SIN panel (escritorio desnudo + fuzzel)
# Lenovo 300e (Celeron N4120, UHD 600, Wi-Fi Intel, fanless)
#
# Este script es la fuente de verdad: `lb config` lo ejecuta automaticamente
# (wrapper auto/config), por lo que debe llamarse con "noauto" para evitar
# recursion infinita. Regenera config/ en cada build.
#
# ROBUSTEZ ANTI-ERRORES:
#   * --apt-recommends true (explicito): apt instala todo lo Recomendado.
#     Nunca usamos --no-install-recommends: prefiero ISO algo mayor a que
#     falte media biblioteca en el arranque.
#   * Reintentos/timeout de APT via apt.conf.d del chroot (ver
#     config/includes.chroot/etc/apt/apt.conf.d/90-retries): un espejo lento
#     no mata el build, y el sistema instalado hereda la misma proteccion.
# ---------------------------------------------------------------------------

# Usuario del live: parametro oficial username= de live-config (procesado
# al arrancar). live-build no tiene --username en esta version; tampoco
# repetimos "boot=live components" aqui: live-build los anade el solo.
lb config noauto \
    --distribution forky \
    --architectures amd64 \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --bootloaders grub-efi \
    --archive-areas "main contrib non-free non-free-firmware" \
    --parent-archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer live \
    --debian-installer-gui false \
    --uefi-secure-boot enable \
    --security true \
    --updates true \
    --backports false \
    --apt-recommends true \
    --memtest none \
    --iso-volume "Debian-14-Labwc-300e" \
    --bootappend-live "username=live locales=es_ES.UTF-8 keyboard-layouts=es timezone=Europe/Madrid utc=yes" \
    "${@}"
